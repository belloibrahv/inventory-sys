generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  CEO
  AUDITOR
  ACCOUNTANT
  BRANCH_MANAGER
  VAULT_MANAGER
  CASHIER
  SALES_EXECUTIVE
  ENGINEER
}

enum ProductCondition {
  BRAND_NEW
  OPEN_BOX
  UK_USED
  REFURBISHED
  SWAP_DEVICE
  FAULTY
  REPAIR_DEVICE
}

enum IMEIStatus {
  RECEIVED
  INCOMING
  IN_STOCK
  TRANSFERRED
  SOLD
  RETURNED
  REPAIRED
  SWAPPED
  DISPOSED
  FAULTY
}

enum ProductTracking {
  IMEI
  SERIAL
  NONE
}

enum IncomingStatus {
  COMING
  ARRIVED
  CANCELLED
}

enum IncomingIdentity {
  IMEI
  SERIAL
  NONE
}

enum PurchaseStatus {
  PENDING
  ORDERED
  PARTIAL_RECEIVED
  RECEIVED
  CANCELLED
}

enum PaymentMethod {
  CASH
  TRANSFER
  POS
  CREDIT
  SPLIT_PAYMENT
}

enum SaleStatus {
  PENDING
  COMPLETED
  CANCELLED
  REFUNDED
}

enum LedgerEntryType {
  SALE
  PAYMENT
  REFUND
  ADJUSTMENT
  DISCOUNT
  CREDIT_NOTE
}

enum ReturnReason {
  FAULTY
  WARRANTY
  CUSTOMER_DISSATISFACTION
  DAMAGED
  SUPPLIER_RETURN
  WRONG_PRODUCT
}

enum ReturnOutcome {
  REPLACEMENT
  REPAIR
  REFUND
  CREDIT_NOTE
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum FaultClass {
  GOOD_STOCK
  FAULTY_STOCK
  REPAIR_STOCK
  SCRAP_STOCK
}

enum SwapStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum RepairStatus {
  PENDING
  DIAGNOSING
  REPAIRING
  WAITING_PARTS
  COMPLETED
  DELIVERED
  CANCELLED
}

enum TransferStatus {
  PENDING
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

enum ExpenseCategory {
  TRANSPORT
  FUEL
  RENT
  UTILITIES
  REPAIRS
  SALARY
  MISCELLANEOUS
  MARKETING
}

enum ApprovalType {
  PRICE_DISCOUNT
  REFUND
  STOCK_ADJUSTMENT
  RECONCILIATION
  EXPENSE
  TRANSFER
  SWAP
  RETURN
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReconciliationStatus {
  IN_PROGRESS
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  APPROVE
  REJECT
  EXPORT
  IMPORT
  DENIED
  VIEW
}

enum NotificationType {
  LOW_STOCK
  PRICE_UPDATE
  APPROVAL_REQUEST
  DUE_PAYMENT
  TRANSFER
  RETURN
  SYSTEM
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String    @unique
  password         String
  role             UserRole  @default(SALES_EXECUTIVE)
  branchId         String?
  branch           Branch?   @relation(fields: [branchId], references: [id])
  isActive           Boolean   @default(true)
  twoFactorEnabled   Boolean   @default(false)
  totpSecret         String?
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  lastLoginIp      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  auditLogs     AuditLog[]
  sales         Sale[]
  purchases     Purchase[]
  expenses      Expense[]
  notifications Notification[]
  transfers     StockTransfer[]
  swaps         Swap[]
  repairs       Repair[]
  returns       StockReturn[]
  approvalsReq  Approval[]       @relation("ApprovalRequester")
  approvalsDec  Approval[]       @relation("ApprovalDecider")
  reconciliations Reconciliation[]
  incomingLots    IncomingLot[]
  dayCloses       DayClose[]

  @@index([email])
  @@index([branchId])
  @@index([role])
}

model Branch {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  address   String
  phone     String?
  email     String?
  isActive  Boolean  @default(true)
  isHq      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  inventory       Inventory[]
  sales           Sale[]
  purchases       Purchase[]
  expenses        Expense[]
  transfersOut    StockTransfer[]   @relation("TransferFrom")
  transfersIn     StockTransfer[]   @relation("TransferTo")
  reconciliations Reconciliation[]
  customers       Customer[]
  imeiRecords     ImeiRecord[]
  swaps           Swap[]
  returns         StockReturn[]
  repairs         Repair[]
  financeEntries  FinanceEntry[]
  incomingLots    IncomingLot[]
  dayCloses       DayClose[]

  @@index([code])
  @@index([isActive])
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Brand {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id           String           @id @default(cuid())
  sku          String           @unique
  name         String
  description  String?
  brandId      String
  brand        Brand            @relation(fields: [brandId], references: [id])
  categoryId   String
  category     Category         @relation(fields: [categoryId], references: [id])
  condition    ProductCondition
  color        String?
  storage      String?
  ram          String?
  costPrice    Decimal
  minimumPrice Decimal
  sellingPrice Decimal
  marketPrice  Decimal?
  warrantyDays Int              @default(365)
  tracking     ProductTracking  @default(IMEI)
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  inventory     Inventory[]
  imeiRecords   ImeiRecord[]
  saleItems     SaleItem[]
  purchaseItems PurchaseItem[]
  priceHistory  PriceHistory[]
  transferItems TransferItem[]
  swaps         Swap[]
  reconItems    ReconciliationItem[]
  incomingItems IncomingItem[]

  @@index([sku])
  @@index([categoryId])
  @@index([brandId])
  @@index([condition])
}

model PriceHistory {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  oldPrice  Decimal
  newPrice  Decimal
  priceType String
  reason    String?
  changedBy String
  changedAt DateTime @default(now())

  @@index([productId])
  @@index([changedAt])
}

model ImeiRecord {
  id           String     @id @default(cuid())
  imei1        String     @unique
  imei2        String?
  serialNumber String?
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierId   String?
  supplier     Supplier?  @relation(fields: [supplierId], references: [id])
  branchId     String
  branch       Branch     @relation(fields: [branchId], references: [id])
  status       IMEIStatus @default(RECEIVED)
  customerId   String?
  customer     Customer?  @relation(fields: [customerId], references: [id])
  saleId       String?
  sale         Sale?      @relation(fields: [saleId], references: [id])
  notes          String?
  cosmeticGrade  String?
  batteryHealth  Int?
  conditionNotes String?
  photoData      String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  saleItems SaleItem[]
  returns   StockReturn[]
  repairs   Repair[]
  swapsOld  Swap[]     @relation("SwapOld")
  swapsNew  Swap[]     @relation("SwapNew")

  @@index([imei1])
  @@index([imei2])
  @@index([serialNumber])
  @@index([productId])
  @@index([branchId])
  @@index([status])
}

model Inventory {
  id            String    @id @default(cuid())
  productId     String
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  branchId      String
  branch        Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  quantity      Int       @default(0)
  incomingQty   Int       @default(0)
  reserved      Int       @default(0)
  minStock      Int       @default(3)
  lastStockCheck DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([productId, branchId])
  @@index([branchId])
}

model Supplier {
  id            String   @id @default(cuid())
  name          String
  contactPerson String?
  email         String?
  phone         String
  address       String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  purchases    Purchase[]
  imeiRecords  ImeiRecord[]
  incomingLots IncomingLot[]

  @@index([isActive])
}

model Purchase {
  id            String         @id @default(cuid())
  invoiceNumber String         @unique
  supplierId    String
  supplier      Supplier       @relation(fields: [supplierId], references: [id])
  branchId      String
  branch        Branch         @relation(fields: [branchId], references: [id])
  userId        String
  user          User           @relation(fields: [userId], references: [id])
  status        PurchaseStatus @default(PENDING)
  totalAmount   Decimal
  paidAmount    Decimal        @default(0)
  paymentMethod String?
  notes         String?
  expectedDate  DateTime?
  receivedDate  DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  items        PurchaseItem[]
  incomingLots IncomingLot[]

  @@index([invoiceNumber])
  @@index([supplierId])
  @@index([branchId])
  @@index([status])
}

model PurchaseItem {
  id          String   @id @default(cuid())
  purchaseId  String
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Int
  costPrice   Decimal
  totalAmount Decimal
  receivedQty Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([purchaseId])
}

model Sale {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  branchId      String
  branch        Branch        @relation(fields: [branchId], references: [id])
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id])
  saleType      String        @default("RETAIL")
  status        SaleStatus    @default(PENDING)
  subtotal      Decimal
  discount      Decimal       @default(0)
  tax           Decimal       @default(0)
  totalAmount   Decimal
  paidAmount    Decimal       @default(0)
  paymentMethod PaymentMethod
  paymentNotes  String?
  notes         String?
  isWholesale   Boolean       @default(false)
  saleDate      DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  items    SaleItem[]
  payments Payment[]
  imeis    ImeiRecord[]

  @@index([invoiceNumber])
  @@index([branchId])
  @@index([customerId])
  @@index([status])
  @@index([saleDate])
}

model SaleItem {
  id         String      @id @default(cuid())
  saleId     String
  sale       Sale        @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId  String
  product    Product     @relation(fields: [productId], references: [id])
  imeiId     String?
  imei       ImeiRecord? @relation(fields: [imeiId], references: [id])
  quantity   Int
  unitPrice  Decimal
  discount   Decimal     @default(0)
  totalPrice Decimal
  createdAt  DateTime    @default(now())

  @@index([saleId])
}

model Payment {
  id        String        @id @default(cuid())
  saleId    String
  sale      Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  amount    Decimal
  method    PaymentMethod
  reference String?
  notes     String?
  paidAt    DateTime      @default(now())

  @@index([saleId])
}

model Customer {
  id             String   @id @default(cuid())
  name           String
  phone          String   @unique
  email          String?
  address        String?
  branchId       String
  branch         Branch   @relation(fields: [branchId], references: [id])
  notes          String?
  creditLimit    Decimal  @default(0)
  currentBalance Decimal  @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sales         Sale[]
  imeiRecords   ImeiRecord[]
  ledgerEntries LedgerEntry[]
  returns       StockReturn[]
  swaps         Swap[]
  repairs       Repair[]

  @@index([phone])
  @@index([branchId])
}

model LedgerEntry {
  id          String          @id @default(cuid())
  customerId  String
  customer    Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type        LedgerEntryType
  amount      Decimal
  balance     Decimal
  reference   String?
  description String?
  createdAt   DateTime        @default(now())

  @@index([customerId])
  @@index([createdAt])
}

model StockReturn {
  id           String        @id @default(cuid())
  returnNumber String        @unique
  customerId   String
  customer     Customer      @relation(fields: [customerId], references: [id])
  saleId       String?
  imeiId       String?
  imei         ImeiRecord?   @relation(fields: [imeiId], references: [id])
  branchId     String
  branch       Branch        @relation(fields: [branchId], references: [id])
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  reason       ReturnReason
  outcome      ReturnOutcome
  faultClass   FaultClass    @default(FAULTY_STOCK)
  status       ReturnStatus  @default(PENDING)
  refundAmount Decimal?
  notes        String?
  approvedBy   String?
  approvedAt   DateTime?
  completedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([returnNumber])
  @@index([branchId])
  @@index([status])
}

model Swap {
  id                 String           @id @default(cuid())
  swapNumber         String           @unique
  customerId         String
  customer           Customer         @relation(fields: [customerId], references: [id])
  oldImeiId          String
  oldImei            ImeiRecord       @relation("SwapOld", fields: [oldImeiId], references: [id])
  oldDeviceCondition ProductCondition
  tradeValue         Decimal
  newProductId       String
  newProduct         Product          @relation(fields: [newProductId], references: [id])
  newProductPrice    Decimal
  newImeiId          String?
  newImei            ImeiRecord?      @relation("SwapNew", fields: [newImeiId], references: [id])
  balanceAmount      Decimal
  branchId           String
  branch             Branch           @relation(fields: [branchId], references: [id])
  userId             String
  user               User             @relation(fields: [userId], references: [id])
  status             SwapStatus       @default(PENDING)
  notes              String?
  approvedBy         String?
  approvedAt         DateTime?
  completedAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([swapNumber])
  @@index([branchId])
  @@index([status])
}

model Repair {
  id                  String       @id @default(cuid())
  repairNumber        String       @unique
  imeiId              String
  imei                ImeiRecord   @relation(fields: [imeiId], references: [id])
  customerId          String?
  customer            Customer?    @relation(fields: [customerId], references: [id])
  branchId            String
  branch              Branch       @relation(fields: [branchId], references: [id])
  userId              String
  user                User         @relation(fields: [userId], references: [id])
  issue               String
  diagnosis           String?
  repairCost          Decimal?
  status              RepairStatus @default(PENDING)
  estimatedCompletion DateTime?
  completedAt         DateTime?
  notes               String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([repairNumber])
  @@index([branchId])
  @@index([status])
}

model StockTransfer {
  id             String         @id @default(cuid())
  transferNumber String         @unique
  fromBranchId   String
  fromBranch     Branch         @relation("TransferFrom", fields: [fromBranchId], references: [id])
  toBranchId     String
  toBranch       Branch         @relation("TransferTo", fields: [toBranchId], references: [id])
  userId         String
  user           User           @relation(fields: [userId], references: [id])
  notes          String?
  status         TransferStatus @default(PENDING)
  sentAt         DateTime?
  receivedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  items TransferItem[]

  @@index([transferNumber])
  @@index([fromBranchId])
  @@index([toBranchId])
  @@index([status])
}

model TransferItem {
  id          String        @id @default(cuid())
  transferId  String
  transfer    StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId   String
  product     Product       @relation(fields: [productId], references: [id])
  quantity    Int
  receivedQty Int           @default(0)
  createdAt   DateTime      @default(now())

  @@index([transferId])
}

model Expense {
  id            String          @id @default(cuid())
  expenseNumber String          @unique
  branchId      String
  branch        Branch          @relation(fields: [branchId], references: [id])
  userId        String
  user          User            @relation(fields: [userId], references: [id])
  category      ExpenseCategory
  amount        Decimal
  description   String
  date          DateTime        @default(now())
  notes         String?
  approvedBy    String?
  approvedAt    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([expenseNumber])
  @@index([branchId])
  @@index([category])
}

model FinanceEntry {
  id          String   @id @default(cuid())
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id])
  account     String
  type        String
  amount      Decimal
  reference   String?
  description String?
  createdAt   DateTime @default(now())

  @@index([branchId])
  @@index([createdAt])
}

model Approval {
  id          String         @id @default(cuid())
  type        ApprovalType
  entityId    String
  entityType  String
  requestedBy String
  requester   User           @relation("ApprovalRequester", fields: [requestedBy], references: [id])
  requestedAt DateTime       @default(now())
  approvedBy  String?
  decider     User?          @relation("ApprovalDecider", fields: [approvedBy], references: [id])
  approvedAt  DateTime?
  status      ApprovalStatus @default(PENDING)
  reason      String?
  notes       String?

  @@index([type])
  @@index([status])
}

model Reconciliation {
  id            String               @id @default(cuid())
  branchId      String
  branch        Branch               @relation(fields: [branchId], references: [id])
  userId        String
  user          User                 @relation(fields: [userId], references: [id])
  startDate     DateTime
  endDate       DateTime
  status        ReconciliationStatus @default(IN_PROGRESS)
  totalExpected Decimal
  totalCounted  Decimal
  variance      Decimal
  notes         String?
  approvedBy    String?
  approvedAt    DateTime?
  completedAt   DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  items ReconciliationItem[]

  @@index([branchId])
  @@index([status])
}

model ReconciliationItem {
  id               String         @id @default(cuid())
  reconciliationId String
  reconciliation   Reconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  productId        String
  product          Product        @relation(fields: [productId], references: [id])
  expectedQty      Int
  countedQty       Int
  variance         Int
  varianceValue    Decimal
  reason           String?
  createdAt        DateTime       @default(now())

  @@index([reconciliationId])
}

model AuditLog {
  id         String      @id @default(cuid())
  userId     String?
  user       User?       @relation(fields: [userId], references: [id])
  action     AuditAction
  entityType String
  entityId   String
  oldValue   String?
  newValue   String?
  ipAddress  String?
  userAgent  String?
  path       String?
  success    Boolean     @default(true)
  risk       String      @default("LOW")
  hash       String?
  branchId   String?
  createdAt  DateTime    @default(now())

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([risk])
  @@index([success])
  @@index([createdAt])
}

model Notification {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  status    NotificationStatus @default(UNREAD)
  actionUrl String?
  createdAt DateTime           @default(now())
  readAt    DateTime?

  @@index([userId])
  @@index([status])
}

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model IncomingLot {
  id           String         @id @default(cuid())
  lotNumber    String         @unique
  branchId     String
  branch       Branch         @relation(fields: [branchId], references: [id])
  supplierId   String?
  supplier     Supplier?      @relation(fields: [supplierId], references: [id])
  userId       String
  user         User           @relation(fields: [userId], references: [id])
  status       IncomingStatus @default(COMING)
  visible      Boolean        @default(false)
  expectedDate DateTime?
  notes        String?
  purchaseId   String?
  purchase     Purchase?      @relation(fields: [purchaseId], references: [id])
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  items        IncomingItem[]

  @@index([branchId])
  @@index([status])
  @@index([purchaseId])
}

model DayClose {
  id            String   @id @default(cuid())
  branchId      String
  branch        Branch   @relation(fields: [branchId], references: [id])
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  closeDate     DateTime
  expectedCash  Decimal
  countedCash   Decimal
  variance      Decimal
  transferTotal Decimal  @default(0)
  posTotal      Decimal  @default(0)
  creditTotal   Decimal  @default(0)
  saleCount     Int      @default(0)
  notes         String?
  createdAt     DateTime @default(now())

  @@index([branchId])
  @@index([closeDate])
}

model IncomingItem {
  id          String           @id @default(cuid())
  lotId       String
  lot         IncomingLot      @relation(fields: [lotId], references: [id], onDelete: Cascade)
  productId   String
  product     Product          @relation(fields: [productId], references: [id])
  quantity    Int
  identity    IncomingIdentity
  identifiers String?
  createdAt   DateTime         @default(now())

  @@index([lotId])
  @@index([productId])
}

model RolePermission {
  id        String   @id @default(cuid())
  role      UserRole
  permKey   String
  allowed   Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([role, permKey])
  @@index([role])
}
