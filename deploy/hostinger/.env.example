# Copy to .env (next to docker-compose.yml) on the server and fill in. Never commit the copy.

# The address staff will open, without https://. Its DNS A record must point
# at this VPS before the first start, so Caddy can get the certificate.
DOMAIN=shop.example.com

# The database this server keeps. Make the password long and random:
#   openssl rand -base64 24 | tr -d '/+='
POSTGRES_DB=abutwins
POSTGRES_USER=abutwins
POSTGRES_PASSWORD=

# Sign-in. NEXTAUTH_URL is the full public address. The secret must be at
# least 32 characters; the app refuses to start on a weak one:
#   openssl rand -base64 32
NEXTAUTH_URL=https://shop.example.com
NEXTAUTH_SECRET=

NEXT_PUBLIC_APP_NAME=Abu Twins Softskills
NEXT_PUBLIC_APP_URL=https://shop.example.com

# How many nightly backups to keep on the server.
BACKUP_KEEP_DAYS=14

# Only for a throwaway test server: creates the demo logins (admin123 and the
# rest). Leave it out on the real shop.
# SEED_DEMO_USERS=true
